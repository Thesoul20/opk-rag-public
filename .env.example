# OPK-RAG public/local example. Copy to .env and change local credentials.
OPK_RAG_VAULT_PATH=examples/public-demo
DATABASE_URL=postgresql://opk_rag:opk_rag@127.0.0.1:55432/opk_rag
OPK_RAG_VECTOR_BACKEND=qdrant
OPK_RAG_QDRANT_URL=http://127.0.0.1:6333
OPK_RAG_QDRANT_COLLECTION=opk_rag_chunks
OPK_RAG_QDRANT_PREFER_GRPC=false
OPK_RAG_QDRANT_TRUST_ENV=false
OPK_RAG_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
OPK_RAG_EMBEDDING_DIMENSION=1024
OPK_RAG_EMBEDDING_DEVICE=auto
OPK_RAG_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
OPK_RAG_RERANKER_DEVICE=auto
OPK_RAG_SEARCH_RERANKER_PRECISION=fp16_autocast
OPK_RAG_ASK_RERANKER_PRECISION=fp32
OPK_RAG_LLM_ALLOW_REMOTE=false
OPK_RAG_LLM_BASE_URL=
OPK_RAG_LLM_MODEL=
OPK_RAG_LLM_API_KEY=
OPK_RAG_SELECTIVE_AGENT_PRODUCTION_ENABLED=false
OPK_RAG_SELECTIVE_AGENT_CANARY_ENABLED=false
OPK_RAG_SELECTIVE_AGENT_LIVE_SHADOW_ENABLED=false
